# Firebase Client SDK Configuration
# These are public values that will be included in the client bundle
# They are safe to commit to version control
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK Configuration (Server-side only)
# CRITICAL: These values must be kept secret and NEVER committed to version control
# CRITICAL: These values should ONLY be set in production environments
# CRITICAL: Never expose these to the client-side code
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# Admin Configuration
# CRITICAL: This email will have admin privileges
# WARNING: Only set this for the initial setup
# After setup, use Firebase custom claims instead
ADMIN_EMAIL=your-admin-email@example.com

# Application Configuration
NODE_ENV=development

# Google reCAPTCHA (if using)
# Get your keys from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Email Configuration (if using contact form)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@example.com

# Security
# CRITICAL: Generate a random string for session secret
SESSION_SECRET=generate-a-random-secret-here

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging (optional)
LOG_LEVEL=info

# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Fill in all the values with your actual credentials
# 3. NEVER commit .env.local to version control
# 4. For production, set these values in your hosting platform's environment variables
# 5. Ensure .env.local is listed in .gitignore
